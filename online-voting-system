# Online Voting System
candidates = {
    1: "Candidate A",
    2: "Candidate B",
    3: "Candidate C"
}
votes = {
    1: 0,
    2: 0,
    3: 0
}
voters = set()
def cast_vote():
    voter_id = input("Enter your voter ID: ")
    if voter_id in voters:
        print("You have already voted!\n")
        return
    print("\nCandidates:")
    for number, name in candidates.items():
        print(number, ".", name)
    try:
        choice = int(input("Enter candidate number: "))
        if choice in candidates:
            votes[choice] += 1
            voters.add(voter_id)
            print("Vote cast successfully!\n")
        else:
            print("Invalid candidate number.\n")
    except ValueError:
        print("Please enter a valid number.\n")
def show_results():
    print("\n===== VOTING RESULTS =====")
    for number, name in candidates.items():
        print(name, ":", votes[number], "votes")
    print()
while True:
    print("===== ONLINE VOTING SYSTEM =====")
    print("1. Cast Vote")
    print("2. View Results")
    print("3. Exit")
    choice = input("Enter your choice: ")
    if choice == "1":
        cast_vote()
    elif choice == "2":
        show_results()
    elif choice == "3":
        print("Thank you for using the Online Voting System.")
        break
    else:
        print("Invalid choice. Please try again.\n")


